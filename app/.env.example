# Local default. Never commit .env or share its values.
PORT=8780
LAB_MODE=local
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
# Explicitly set a spend ceiling; no positive ceiling means generation is blocked.
HIGGSFIELD_TEST_BUDGET_USD=0
LAB_MAX_STORAGE_BYTES=10737418240
# Production only: exact HTTPS origin, no trailing slash.
# APP_ORIGIN=https://your-domain.example
# LAB_INVITE_CODE=
# LAB_TRUST_PROXY=1
# LAB_DATA_DIR=/data
# SEGMENTATION_PYTHON=/opt/sam2-venv/bin/python
# SAM2_CHECKPOINT=/models/sam2.1_hiera_tiny.pt

# Preferred SDK credentials: put HF_CREDENTIALS=key-id:key-secret in .env.local.
# Do not prefix credentials with VITE_.

# Optional decision routing; put the real key only in ignored .env.local.
TYPESAFE_API_KEY=
